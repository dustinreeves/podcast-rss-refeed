# The first (admin) account, created the first time the container starts.
# Change the password afterwards in the web UI (Account). Leave ADMIN_PASSWORD
# blank to get a one-time setup link in the logs instead.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Public address the merged feed is served from, e.g. https://refeed.example.com
BASE_URL=

# How often to check every show for new episodes.
REFRESH_MINUTES=30

# Optional HTTP proxy for feeds marked "Fetch through proxy" (e.g. a VPN container
# such as gluetun with HTTPPROXY=on: http://gluetun:8888).
FETCH_PROXY=
